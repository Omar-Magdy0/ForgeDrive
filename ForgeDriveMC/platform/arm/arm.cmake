# FreeRTOS port mapping: DEVICE_CPU_CORE -> FreeRTOS port name

if(DEVICE_CPU_CORE STREQUAL "CORTEX_M0")
    set(FREERTOS_PORT ARM_CM0)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M0PLUS")
    set(FREERTOS_PORT ARM_CM0)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M3")
    set(FREERTOS_PORT ARM_CM3)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M4")
    set(FREERTOS_PORT ARM_CM4F)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M4F")
    set(FREERTOS_PORT ARM_CM4F)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M7")
    set(FREERTOS_PORT ARM_CM7)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M23")
    set(FREERTOS_PORT ARM_CM23_NTZ)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M33")
    set(FREERTOS_PORT ARM_CM33_NTZ)

elseif(DEVICE_CPU_CORE STREQUAL "CORTEX_M55")
    set(FREERTOS_PORT ARM_CM55_NTZ)

else()
    message(FATAL_ERROR
        "No FreeRTOS port mapping for DEVICE_CPU_CORE='${DEVICE_CPU_CORE}'"
    )
endif()